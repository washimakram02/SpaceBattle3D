<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="3D Space Defender" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/SpaceDefender3D" prefix_auto="1" extension_auto="1" />
				<Option working_dir="./" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=c++11" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add library="glut32" />
					<Add library="glu32" />
					<Add library="opengl32" />
					<Add library="winmm" />
					<Add directory="lib" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="SpaceDefender3D" prefix_auto="1" extension_auto="1" />
				<Option working_dir="./" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=c++11" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="glut32" />
					<Add library="glu32" />
					<Add library="opengl32" />
					<Add library="winmm" />
					<Add directory="lib" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=c++11" />
			<Add directory="include" />
		</Compiler>
		<Linker>
			<Add library="glut32" />
			<Add library="glu32" />
			<Add library="opengl32" />
			<Add library="winmm" />
			<Add directory="lib" />
		</Linker>
		<Unit filename="Bullet.h" />
		<Unit filename="Camera.h" />
		<Unit filename="Enemy.h" />
		<Unit filename="Game.cpp" />
		<Unit filename="Game.h" />
		<Unit filename="Missile.h" />
		<Unit filename="Particle.h" />
		<Unit filename="Player.h" />
		<Unit filename="PowerUp.h" />
		<Unit filename="SoundManager.cpp" />
		<Unit filename="SoundManager.h" />
		<Unit filename="main.cpp" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
